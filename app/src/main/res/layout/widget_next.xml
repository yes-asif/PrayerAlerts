<?xml version="1.0" encoding="utf-8"?>
<!-- Small 2x2: active prayer with the time it has left -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_bg_green">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1.5dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/wg_ornament_small" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_bold"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:text="FAJR"
            android:textColor="@color/wg_gold"
            android:textSize="17sp" />

        <Chronometer
            android:id="@+id/w_count"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:autoSizeMaxTextSize="36sp"
            android:autoSizeMinTextSize="18sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/montserrat_bold"
            android:gravity="center"
            android:maxLines="1"
            android:shadowColor="@color/wg_gold_glow"
            android:shadowRadius="14"
            android:textColor="@color/wg_white"
            android:textSize="36sp" />

        <TextView
            android:id="@+id/w_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat"
            android:maxLines="1"
            android:text="left"
            android:textColor="@color/wg_green_text"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
